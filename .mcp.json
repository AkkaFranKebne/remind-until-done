{
  "mcpServers": {
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:1.3.0@sha256:423a6b8e2ee06affcf090892f40c86469caba45fd2448ffa8ca5d717a174f7d5",
        "stdio",
        "--toolsets=registry"
      ]
    },
    "gopls": {
      "command": "sh",
      "args": ["-c", "cd api && exec gopls mcp"]
    }
  }
}
